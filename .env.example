# Servidor
PORT=9000

# Chave mestra para criar tenants via POST /admin/tenants
ADMIN_KEY=troque-esta-chave-por-uma-bem-forte

# Banco de dados (Postgres)
DATABASE_URL="postgresql://usuario:senha@localhost:5432/whatsapp_api?schema=public"

# Redis (BullMQ)
REDIS_HOST=localhost
REDIS_PORT=6379

# Onde ficam as sessoes do whatsapp-web.js (LocalAuth)
SESSIONS_PATH=./.wwebjs_auth
