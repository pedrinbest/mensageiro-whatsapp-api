# Servidor
PORT=9000

# Chave mestra para criar tenants via POST /admin/tenants
# IMPORTANTE: Troque por uma chave longa e segura em producao!
ADMIN_KEY=troque-esta-chave-por-uma-bem-forte

# Banco de dados (MySQL)
DATABASE_URL="mysql://usuario:senha@localhost:3306/whatsapp_api"

# Redis (BullMQ)
REDIS_HOST=localhost
REDIS_PORT=6379

# Onde ficam as sessoes do whatsapp-web.js (LocalAuth)
SESSIONS_PATH=./.wwebjs_auth
